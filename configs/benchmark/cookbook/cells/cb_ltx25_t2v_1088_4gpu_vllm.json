{
  "id": "cb_ltx25_t2v_1088_4gpu_vllm",
  "label": "LTX-2.5 distilled two-stage T2V 1920x1088 121f 8+3 steps (vLLM-Omni recipe, 4 GPUs)",
  "base_case": "ltx2.5_twostage_t2v_2gpus",
  "set": {
    "num_gpus": 4
  },
  "unset": [
    "frameworks.vllm-omni.extra_env.DIFFUSION_ATTENTION_BACKEND"
  ],
  "cookbook": {
    "framework": "vllm-omni",
    "repo": "vllm-project/vllm-omni",
    "path": "recipes/LTX/LTX-2.5.md",
    "commit": "a0910980",
    "commit_date": "2026-10-17",
    "section": "### Multi-GPU low-latency path",
    "source_hardware": "4 GPUs (Ulysses 4 + VAE patch parallel 4); B300 verified",
    "source_metric": "none published for this pipeline",
    "workload": {
      "width": 1920,
      "height": 1088,
      "num_frames": 121,
      "fps": 24,
      "num_inference_steps": 8,
      "num_gpus": 4,
      "dit_forwards": 11,
      "metric": "not stated",
      "warmup": "not stated",
      "repeats": "not stated"
    },
    "source_gpu": [
      "b300"
    ]
  },
  "forwards": {
    "vllm-omni": 11,
    "sglang": null
  },
  "deviations": [
    {
      "field": "metric",
      "source": "not stated",
      "run": "client_e2e_median",
      "reason": "every arm is timed by the same client; the source's own timer is not available for the other frameworks"
    },
    {
      "field": "warmup",
      "source": "not stated",
      "run": "3 request(s) at 8 steps",
      "reason": "the harness warms every arm the same way before timing"
    },
    {
      "field": "repeats",
      "source": "not stated",
      "run": "median of 2",
      "reason": "the harness takes the same median for every arm"
    }
  ],
  "arms": {
    "vllm-omni": {
      "cb-vllm-verbatim": {
        "tier": "verbatim",
        "num_gpus": 4,
        "upstream_recipe": {
          "repo": "vllm-project/vllm-omni",
          "path": "recipes/LTX/LTX-2.5.md",
          "commit": "a0910980",
          "commit_date": "2026-10-17",
          "section": "### Multi-GPU low-latency path"
        },
        "serve_args": "--num-gpus 4 --model-class-name LTX2DistilledTwoStagePipeline --usp 4 --vae-patch-parallel-size 4 --vae-use-tiling --stage-init-timeout 900"
      }
    },
    "sglang": {
      "cb-sgl-cookbook": {
        "tier": "verbatim",
        "num_gpus": 4,
        "upstream_recipe": {
          "repo": "sgl-project/sglang",
          "path": "docs/cookbook/diffusion/LTX/LTX2.5.mdx",
          "commit": "af7d941fc3",
          "commit_date": "2026-10-24",
          "section": "### 3.3 Multi-GPU presets: '2 GPUs, long sequences' + ### 3.2 Configuration Tips (on >=130 GiB GPUs pass the served shape via --warmup-resolutions / --warmup-num-frames)"
        },
        "serve_args": "--pipeline-class-name LTX2TwoStagePipeline --ulysses-degree 4 --warmup-resolutions 1920x1088 --warmup-num-frames 121",
        "scaled_from": {
          "num_gpus": 2,
          "serve_args": "--pipeline-class-name LTX2TwoStagePipeline --num-gpus 2 --ulysses-degree 2 --warmup-resolutions 1920x1088 --warmup-num-frames 121"
        },
        "notes": "The cookbook's 2-GPU preset (it has none for 4) by the rule: Ulysses 4."
      }
    }
  },
  "notes": "LightX2V ships configs/ltx2/ltx2_5_distilled.json (ce0f526ae62c), but the harness has never served LTX-2.5 through LightX2V (headline status unsupported); add its arm once that path is validated."
}
