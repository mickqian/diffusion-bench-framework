    "sglang": 8
  },
  "deviations": [
    {
      "field": "metric",
      "source": "offline API, one request per row",
      "run": "client_e2e_median",
      "reason": "every arm is timed by the same client; the source's own timer is not available for the other frameworks"
    },
    {
      "field": "warmup",
      "source": "1 request",
      "run": "3 request(s) at 3 steps",
      "reason": "the harness warms every arm the same way before timing"
    },
    {
      "field": "repeats",
      "source": "one request",
      "run": "median of 2",
      "reason": "the harness takes the same median for every arm"
    }
  ],
  "arms": {
    "vllm-omni": {
      "cb-vllm-verbatim": {
        "tier": "verbatim",
        "num_gpus": 2,
        "upstream_recipe": {
          "repo": "vllm-project/vllm-omni",
          "path": "recipes/MiniMaxAI/MiniMax-H3.md",
          "commit": "fb7ab707",
          "commit_date": "2026-10-26",
          "section": "### VDN-H3 checkpoint"
        },
        "serve_args": "--trust-remote-code --task-type fl2va --lora-path OpenVDN/vdn-minimax-h3 --diffusion-attention-backend VDNH3_ATTN --tensor-parallel-size 2 --text-encoder-tp-size 2 --vae-patch-parallel-size 2",
        "extra_env": {
          "VLLM_WORKER_MULTIPROC_METHOD": "spawn"
        },
        "notes": "On B200 this failed in round 1: VDNH3_ATTN runs its window as dense FlashAttention, which vLLM-Omni does not have on Blackwell (worker EOFError before health). Run it on H200."
      }
    },
    "sglang": {
      "cb-sgl-cookbook": {
        "tier": "verbatim",
        "num_gpus": 2,
        "upstream_recipe": {
          "repo": "sgl-project/sglang",
          "path": "docs/cookbook/diffusion/MiniMax/MiniMax-H3.mdx",
          "commit": "0498ab7b6ee2",
          "commit_date": "2026-10-24",
          "section": "## 7. VDN-H3: hybrid attention, 8-step distill"
        },
        "serve_args": "--attention-backend hybrid_window_attn_h3 --performance-mode speed --warmup-num-frames 345 --warmup-resolutions 1344x768",
        "scaled_from": {
          "num_gpus": 8,
          "serve_args": "--num-gpus 8 --attention-backend hybrid_window_attn_h3 --performance-mode speed --warmup-num-frames 345 --warmup-resolutions 1344x768"
        },
        "notes": "The cookbook's 8x B200 command; it states --num-gpus 4, 2 or 1 gives the smaller Ulysses recipes. On Blackwell the DiT defaults to online MXFP8 (lossy); H200 runs BF16."
      }
    }
  }
