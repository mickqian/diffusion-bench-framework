  "4": {"class_type": "MultiGPU_WorkUnits", "inputs": {"model": ["1", 0], "max_gpus": "{{cfg_gpus}}"}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["2", 0], "__bench_nonce": "{{nonce}}"}},
