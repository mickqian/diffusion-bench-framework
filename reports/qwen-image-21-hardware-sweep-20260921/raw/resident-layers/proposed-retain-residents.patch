+def test_release_all_drops_residents_by_default(monkeypatch):
+    """The default is unchanged: a use ends and the resident set goes with it.
+
+    `resident_layers` defaults to 0 everywhere, so this is the path every
+    existing deployment takes and it must keep behaving exactly as before.
+    """
+    _patch_fake_device(monkeypatch)
+    manager = _resident_manager(
+        _MultiBlockModel(6), num_layers=6, prefetch_size=1, resident_layers=3
+    )
+    _arm_residency(manager)
+    manager.prepare_for_next_req(non_blocking=False)
+    assert manager._gpu_layers
+
+    manager.release_all()
+    assert not manager._gpu_layers
+    assert manager._first_pass is True
+
+
+def test_release_all_can_keep_the_resident_set(monkeypatch):
+    """`keep_resident` widens the set's scope to the next use of the component.
+
+    Without it, a component that runs once per request -- a text encoder --
+    prefetches its resident set at prepare_for_use and drops it again at
+    finish_use, so `resident_layers` buys nothing at all. Measured on
+    Qwen-Image-2.1/RTX 5090: `--layerwise-resident-layers text_encoder=0.8`
+    reported `resident=53/66` and moved neither memory nor latency.
+    """
+    _patch_fake_device(monkeypatch)
+    manager = _resident_manager(
+        _MultiBlockModel(6), num_layers=6, prefetch_size=1, resident_layers=3
+    )
+    _arm_residency(manager)
+    manager.prepare_for_next_req(non_blocking=False)
+
+    manager.release_all(keep_resident=True)
+    assert set(manager._gpu_layers) == set(manager._retained_set)
+    # Those layers are already faulted in, so the next use must not re-do the
+    # sequential first pass that exists for evicted pages.
+    assert manager._first_pass is False
+
+
+def test_retain_across_uses_is_off_without_resident_layers(monkeypatch):
+    """No resident set configured -> nothing to retain, whatever the headroom."""
+    _patch_fake_device(monkeypatch)
+    manager = _resident_manager(
+        _MultiBlockModel(6), num_layers=6, prefetch_size=1, resident_layers=0
+    )
+    assert manager.retained_parameter_bytes() == 0
+
+
+def test_retain_across_uses_yields_when_the_room_is_needed(monkeypatch):
+    """Configured, but the device is near full -> give the room back.
+
+    The test is on the margin left after the set, not on the set's own size:
+    the caller frees the streamed window before asking, so what is free at that
+    point is what the next stage will actually get.
+    """
+    _patch_fake_device(monkeypatch)
+    manager = _resident_manager(
+        _MultiBlockModel(6), num_layers=6, prefetch_size=1, resident_layers=3
+    )
+    monkeypatch.setattr(manager, "_managed_parameter_bytes", lambda: 8 << 30)
+    # 3 of 6 layers resident -> half the managed bytes.
+    assert manager.retained_parameter_bytes() == 4 << 30
+
+    module = _MultiBlockModel(6)
+    module.layerwise_offload_managers = [manager]
+    monkeypatch.setattr(
+        layerwise_offload_mod.current_platform,
+        "get_device_total_memory",
+        lambda device_id=0: 32 << 30,
+    )
+
+    # Below the margin (10% of 32 GiB) the room goes back to the next stage.
+    module._device_headroom_bytes = lambda: 1 << 30
+    assert (
+        LayerwiseOffloadableModuleMixin.should_retain_residents_across_uses(module)
+        is False
+    )
+
+    # Above it, the set is worth holding until this component is used again.
+    module._device_headroom_bytes = lambda: 6 << 30
+    assert (
+        LayerwiseOffloadableModuleMixin.should_retain_residents_across_uses(module)
